---
import '../styles/molecules.scss';
const { frontmatter } = Astro.props;
---
<html>
  <head>
    <!-- ... -->
    <meta charset="utf-8">
  </head>
  <!-- ... -->
  <article
    data-pagefind-body
    data-pagefind-filter={frontmatter.type ? `type:${frontmatter.type}` : undefined}
