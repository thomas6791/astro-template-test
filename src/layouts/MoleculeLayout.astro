---
const { frontmatter } = Astro.props;
---
<html>
  <head>
    <meta charset="utf-8">
  </head>
  <article
    data-pagefind-body
    data-pagefind-filter={frontmatter.type ? `type:${frontmatter.type}` : undefined}
  >
    <span
      data-pagefind-meta="title"
      style="display:none"
    >
      {frontmatter.molecule}
    </span>
    <h1>{frontmatter.title}</h1>
    <slot />
  </article>
</html>