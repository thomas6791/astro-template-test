---
import Search from "astro-pagefind/components/Search.astro";
import '../styles/molecules.scss';
const allMolecules = Object.values(import.meta.glob('./molecules/*.md', { eager: true }));
//import {Search} from "astro-pagefind/components/Search.astro";
---
<html lang="fr">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width" />
    <title>Astro</title>
  </head>
  <body>
    <a href="/">Accueil</a>
    <a href="/about/">À propos</a>
    <a href="/blog/">Blog</a>

    <h1>Mon blog d'apprentissage d'Astro</h1>
    <p>Voici où je vais publier mon parcours d'apprentissage d'Astro.</p>
    <Search instance="search" className="pagefind-ui" searchboxOptions={{ placeholder: "search" }} filters={{ type: "molecule" }} />
    <ul id="list_molecules">
      {allMolecules.map((molecule: any) => <li><a href={molecule.url}>{molecule.frontmatter.molecule.toUpperCase()}</a></li>)}
    </ul>
  </body>
</html>